# The admin panel is built here rather than committed: a dist in git drifts from
# the sources it was built from, and nothing catches it - the binary just ships a
# stale interface. Building it in the image means what ends up embedded always
# comes from the sources next to it.
FROM node:22-alpine AS ui
WORKDIR /ui
COPY ui/package.json ui/package-lock.json ./
RUN npm ci
COPY ui/ ./
RUN npm run build

FROM golang:1.23.2 AS build
ENV CGO_ENABLED=0
ENV GOOS=linux

WORKDIR /go/src/github.com/bricks-cloud/bricksllm/
COPY . /go/src/github.com/bricks-cloud/bricksllm/
COPY --from=ui /ui/dist ./ui/dist
RUN go build -ldflags="-s -w" -o ./bin/bricksllm ./cmd/bricksllm/main.go

FROM alpine:3.20
RUN apk --no-cache add ca-certificates
WORKDIR /usr/bin
COPY --from=build /go/src/github.com/bricks-cloud/bricksllm/bin /go/bin
EXPOSE 8001 8002
ENTRYPOINT ["/go/bin/bricksllm"]

CMD ["-m", "production"]